<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CurbeInterpolareNewton.MainWindow"
        Title="Interpolare Newton - Tema GC"
        Width="1000" Height="700"
        Background="#1a1a2e">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Background="#16213e" Padding="15,10">
            <StackPanel Orientation="Horizontal" Spacing="20">
                <TextBlock Text="Interpolare Newton" 
                           Foreground="#e94560" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" 
                           Text="Click stanga = adauga punct | Click dreapta = deseneaza polinom"
                           Foreground="#a8a8b3" FontSize="13"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Margin="10" Background="#0f3460" CornerRadius="8"
                ClipToBounds="True">
            <Canvas x:Name="DrawCanvas" Background="Transparent"/>
        </Border>
        <Border Grid.Row="2" Background="#16213e" Padding="15,8">
            <StackPanel Orientation="Horizontal" Spacing="20">
                <TextBlock x:Name="PointCountText" Text="Puncte: 0" 
                           Foreground="#a8a8b3" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock x:Name="MethodText" Text="Metoda: Newton (diferente divizate)" 
                           Foreground="#e94560" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock x:Name="CoordText" Text="" 
                           Foreground="#a8a8b3" FontSize="12" VerticalAlignment="Center"/>
                <Button x:Name="ResetButton" Content="Reset (R)" 
                        Background="#e94560" Foreground="White"
                        Padding="12,4" FontSize="12"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
